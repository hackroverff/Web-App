# Sathvika MV — configuration (all values optional; defaults work for local demo)

# HTTP
PORT=4173
HOST=0.0.0.0
# Comma separated list of allowed origins for CORS. Empty = same-origin only (recommended).
ALLOWED_ORIGINS=

# Storage
DATA_DIR=./data
DB_FILE=sathvika.db

# Security
# Session lifetime in days (customer + owner web sessions).
SESSION_DAYS=30
# Minutes an elevated (password-verified) owner session stays valid before it drops back to PIN-only.
ELEVATED_MINUTES=30
# Set to 0 in production: OTP codes are then never returned by the API (only sent over SMS gateway).
EXPOSE_OTP=1
# Optional secret used to sign cookies. A random one is generated & persisted in DATA_DIR if unset.
COOKIE_SECRET=
# Pepper mixed into every PIN before hashing (scrypt). Set this in production so a stolen
# database cannot be brute-forced against the tiny 4-digit keyspace.
PIN_PEPPER=
# Framing. The app refuses to be embedded (frame-ancestors 'none'). A device/preview iframe
# needs the parent origin, e.g. FRAME_ANCESTORS="'self' https://preview.example".
FRAME_ANCESTORS='none'
# SameSite auto-upgrade for framed clients + a bearer copy of the session token.
# Both are needed when the app runs inside another site's iframe, where a Lax cookie
# is dropped; leave them on unless you are auditing every client.
SAME_SITE_AUTO=1
BEARER_TOKENS=1
# Cookie hardening. SECURE_COOKIES=1 requires HTTPS; SAME_SITE is lax|strict|none.
SECURE_COOKIES=0
SAME_SITE=lax

# OTP / rate limiting
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=15

# Owner demo credentials (overridden by values stored in DB after first run)
OWNER_PIN=4321
OWNER_PASSWORD=sathvika@owner2026
ADMIN_PASSWORD=sathvika@owner2026

# Notification gateway. "log" = write to the in-app outbox (default, works offline).
# Set to "webhook" to POST to an SMS/WhatsApp provider (MSG91, Twilio, Gupshup, Interakt...).
NOTIFY_PROVIDER=log
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
NOTIFY_SENDER_ID=SMVSPT
UPI_INTENT_SCHEME=upi
